rules_version = '2';

// Firestore security rules for the Wariors admin dashboard.
// Publish them in: Firebase console → Firestore Database → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff = the shared login (username "wariors"), or any extra login listed in admins/{UID}.
    // Self sign-up is switched off in Firebase Authentication, so these accounts can only be
    // created by the project owner in the Firebase console.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wariors@wariors-admin.firebaseapp.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Staff list. Managed in the Firebase console; each user may only check their own entry.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Activity log: staff can add and read entries, nobody can edit or delete them.
    match /activity/{id} {
      allow read, create: if isAdmin();
    }

    // Everything else in the dashboard: staff only. Nothing is readable without signing in.
    // receipts = receipt details and a small preview; receiptImages = the full-size photos; dailyReports = one per day.
    match /{col}/{id} {
      allow read, write: if isAdmin()
        && col in ['members', 'memberships', 'payments', 'expenses', 'equipment', 'leads', 'handouts', 'attendance', 'settings', 'receipts', 'receiptImages', 'dailyReports'];
    }
  }
}
