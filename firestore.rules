rules_version = '2';

// Firestore security rules for the Wariors admin dashboard.
// Publish them in: Firebase console → Firestore Database → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user is staff only if admins/{their UID} exists.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Staff list. Managed in the Firebase console; each user may only check their own entry.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Activity log: staff can add and read entries, nobody can edit or delete them.
    match /activity/{id} {
      allow read, create: if isAdmin();
    }

    // Everything else in the dashboard: staff only. Nothing is readable without signing in.
    match /{col}/{id} {
      allow read, write: if isAdmin()
        && col in ['members', 'memberships', 'payments', 'expenses', 'equipment', 'leads', 'handouts', 'attendance', 'settings'];
    }
  }
}
