rules_version = '2';

// Firestore security rules for the Wariors website + admin dashboard.
// Publish them in: Firebase console → Firestore Database → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user is staff only if admins/{their UID} exists.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // Staff list. Managed by the owner in the Firebase console; each user may only check their own entry.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Free-trial requests. The public website form may create one with exactly these fields.
    // Only staff can read, change or delete them.
    match /leads/{id} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll(['name', 'phone', 'program', 'ageGroup', 'preferredTime', 'message', 'source', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'program', 'ageGroup', 'preferredTime', 'message', 'source', 'status', 'createdAt'])
        && str(request.resource.data.name, 100) && request.resource.data.name.size() > 0
        && str(request.resource.data.phone, 30) && request.resource.data.phone.size() >= 7
        && str(request.resource.data.program, 60)
        && str(request.resource.data.ageGroup, 60)
        && str(request.resource.data.preferredTime, 40)
        && str(request.resource.data.message, 1000)
        && request.resource.data.source == 'Website'
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
      );
      allow read, update, delete: if isAdmin();
    }

    // Activity log: staff can add and read entries, nobody can edit or delete them.
    match /activity/{id} {
      allow read, create: if isAdmin();
    }

    // Everything else in the dashboard: staff only.
    match /{col}/{id} {
      allow read, write: if isAdmin()
        && col in ['members', 'payments', 'expenses', 'equipment', 'attendance', 'settings'];
    }
  }
}
